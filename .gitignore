# Dependencies
node_modules/

# Environment variables (NEVER commit)
.env

# Database
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/

# System
.DS_Store
Thumbs.db

# Build artifacts & test coverage
dist/
.cache/
coverage/

# Local Docker volume
data/

# Personal local Docker overrides (container name/port remaps for parallel worktrees)
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo

# Text files with tokens/keys (safety net)
*.txt
!public/robots.txt
!docs/robots.txt

# Screenshot generation scripts (dev tooling, not part of the app)
create-screenshots*.js
custom-screenshots.js
seed-demo-simple.js
seed-english-demo*.js
# Ad-hoc Playwright shooters at the repo root - throwaway, one per audit session.
.shoot*.mjs
.measure.mjs
# Leading slash: this is meant for a generator output folder at the repo root.
# Without it the pattern also matched docs/screenshots/, which IS the website -
# its PNGs only stayed versioned because they predate this rule, while anything
# added later (the WebP variants, new locale folders) was silently dropped.
/screenshots/

# Database backup files
*.db.backup-*
# Working copies that server/db.js leaves next to the database: the one it builds a
# new database in (<DB_PATH>.creating), the one the encryption pass writes
# (<DB_PATH>.encrypting) and the plaintext copy it keeps afterwards
# (<DB_PATH>.plaintext-backup, timestamped when an older one is already there).
# None of them match *.db - that pattern needs the name to end in .db.
*.db.creating
*.db.encrypting
*.db.plaintext-backup
*.db.plaintext-backup-*

# Duplicate GitHub Pages staging folder
docs/github-pages/

# macOS sync duplicates (" 2" suffix)
* 2.*
