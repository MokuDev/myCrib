{
  "manifestVersion": 1,
  "id": "habit-island",
  "name": "Habit Island",
  "version": "1.0.0",
  "description": "Habit tracker with seeds, a growing island, stats and a household leaderboard.",
  "entry": "index.js",
  "style": "style.css",
  "icon": "sprout",
  "accent": "#7C3AED",
  "i18n": {
    "defaultLocale": "de"
  },
  "menu": {
    "show": true,
    "label": "Habit Island",
    "labelKey": "menu",
    "icon": "sprout",
    "order": 100
  },
  "page": {
    "composition": "dashboard",
    "width": "wide",
    "navigation": "standard",
    "responsive": "standard"
  },
  "capabilities": {
    "permissions": {
      "module": {
        "label": "Habit Island",
        "labelKey": "module",
        "icon": "sprout"
      },
      "widgets": [
        {
          "id": "summary",
          "label": "Habits today"
        }
      ]
    },
    "widgets": [
      {
        "id": "summary",
        "entry": "widgets/summary.js",
        "label": "Habits today",
        "labelKey": "widgets.summary",
        "icon": "sprout",
        "defaultSize": "1x2",
        "defaultVisible": false,
        "optionsSchema": {
          "compact": {
            "type": "boolean",
            "title": "Compact mode",
            "titleKey": "options.compact",
            "default": false
          }
        }
      }
    ],
    "api": {
      "prefix": "/api/extensions/habit-island"
    }
  }
}
